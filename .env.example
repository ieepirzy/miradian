# Copy to .env and fill in. Never commit .env.

# Absolute path to your Obsidian vault on the host.
VAULT_PATH=/path/to/your/vault

# Host address the MCP port is published on, alongside loopback.
# Use a private/VPN interface (e.g. a WireGuard peer address such as 10.8.0.8).
# Never 0.0.0.0 -- that exposes the vault to your LAN, and possibly the internet.
BOUND_IP=127.0.0.1
PORT=27125

# Externally visible base URL. All OAuth metadata is derived from it, so it must
# match the URL clients actually reach.
MCP_BASE_URL=https://miradian.example.com

# OAuth client credentials. Generate a strong secret, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_CLIENT_ID=miradian
MCP_CLIENT_SECRET=

# Skip the consent page. Fine for a single-user server.
MCP_AUTO_APPROVE=true
# Leave off unless a connector refuses manual credentials and needs to self-register.
MCP_PUBLIC_REGISTRATION=false

# Stamp agent-written notes so you can tell them from your own. On by default.
MARK_AI_GENERATED=true
AI_GENERATED_FIELD=ai_generated
STAMP_DATE=true
