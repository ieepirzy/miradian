# Copy to .env and fill in. Never commit .env.

# Absolute path to your Obsidian vault on the host.
VAULT_PATH=/path/to/your/vault

# Host address the MCP port is published on, alongside loopback.
# Use a private/VPN interface (e.g. a WireGuard peer address such as 10.8.0.8).
# Never 0.0.0.0 -- that exposes the vault to your LAN, and possibly the internet.
BOUND_IP=127.0.0.1
PORT=27125

# The URL clients actually reach this server at -- NOT the address it binds to.
#
# Everything OAuth is derived from it: the issuer, the /authorize and /token URLs
# advertised in discovery, and the resource identifier tokens are bound to
# (MCP_BASE_URL + MCP_PATH). The server never infers this from the request, so if
# it doesn't match the URL the client dialled, the client is redirected somewhere
# it can't reach, or its token's resource won't match and every call 401s.
#
# Include the port if clients use one. Examples:
#   behind a reverse proxy: https://miradian.example.com
#   straight over a VPN:    http://10.8.0.8:27125   (BOUND_IP + PORT)
MCP_BASE_URL=https://miradian.example.com

# OAuth client credentials. Generate a strong secret, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_CLIENT_ID=miradian
MCP_CLIENT_SECRET=

# Allowlist of redirect URIs for that client, comma-separated. Leave unset and
# origo accepts ANY redirect_uri -- anyone who learns the client id can start an
# authorize flow and have the code delivered to a URI they control.
MCP_REDIRECT_URIS=

# Skip the consent page. Fine for a single-user server.
MCP_AUTO_APPROVE=true
# Leave off unless a connector refuses manual credentials and needs to self-register.
MCP_PUBLIC_REGISTRATION=false

# Stamp agent-written notes so you can tell them from your own. On by default.
MARK_AI_GENERATED=true
AI_GENERATED_FIELD=ai_generated
STAMP_DATE=true

# --- structured-document API (/api/v1) ---------------------------------------
#
# Bearer tokens for service consumers, as name:secret pairs. The name never leaves
# the log line; the secret is what the client sends. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# LEAVE THIS UNSET and /api/v1 refuses every request. That is deliberate: an
# upgrade must not quietly expose the vault because nobody knew to set it.
MIRADIAN_API_TOKENS=

# Vault-relative directories whose subdirectories are projects. Separated by "::",
# not a comma: vault folder names contain commas, spaces and emoji.
PROJECT_ROOTS=03 🛠 Projects

# The frontmatter field that marks a document as project state rather than ordinary
# notes. Only documents carrying it are listed, watched for changes, or given a uid.
DOC_TYPE_FIELD=doc_type

# Document identity. miradian stamps this field into managed documents so a uid
# survives moves, renames and sync. Set ASSIGN_UID=false to leave files untouched;
# documents then have no stable id and are addressable by path only.
UID_FIELD=uid
ASSIGN_UID=true

# Where the change journal lives. Must be OUTSIDE the vault -- inside it, Syncthing
# would replicate it between machines that each write their own sequence numbers,
# and git would track a file that changes on every poll. The server refuses to
# start if this points into the vault. The container sets it to /state.
STATE_DIR=

# Frontmatter schema enforcement. Applies to the MCP tools only -- /api/v1 is not
# schema-validated, because a service consumer has no human to approve a new tag.
# The schema lives in the vault (METADATA.md);
# a vault without one degrades to 'off' automatically.
#   strict = refuse writes that break the schema
#   warn   = write anyway, but report the problems
#   off    = no validation
SCHEMA_MODE=strict
